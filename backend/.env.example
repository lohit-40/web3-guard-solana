# ──────────────────────────────────────────────────────
#  Web3 Guard — Solana Autonomous Agent — .env.example
#  Copy this to .env and fill in your values
# ──────────────────────────────────────────────────────

# --- REQUIRED FOR AI SCANNING ---
# Comma-separated for failover between keys
GEMINI_API_KEY=AIzaSyD-PmenbVX1uT8sN4GZweZcf4yZ9UfpWv8

# --- REQUIRED FOR SOLANA MONITORING ---
# Get free API key from https://helius.dev
HELIUS_KEY=aabfdf66-d2ae-47d7-9f5c-6ed80e26e678
# Defaults to devnet if Helius key is missing
NEXT_PUBLIC_HELIUS_RPC=https://devnet.helius-rpc.com/?api-key=aabfdf66-d2ae-47d7-9f5c-6ed80e26e678

# --- REQUIRED FOR TELEGRAM BOT ALERTS ---
# Create bot via @BotFather on Telegram, then paste token here
TELEGRAM_BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE
# Your publicly accessible URL for webhook registration (e.g. Railway URL or ngrok)
# Example: https://web3guard.up.railway.app
BASE_URL=https://web3-guard-solana-173382554287.europe-west1.run.app

# --- OPTIONAL: SOLANA PROOF-OF-AUDIT ---
# 64-byte hex private key of a devnet wallet with ~0.1 SOL
# Used to sign memo transactions anchoring audit proofs on-chain
WALLET_PRIVATE_KEY=1b86046a825dbd54ec74d2a3d9eb0b9041ec4992c80dd388a42eb81bbe521b2b

# --- OPTIONAL: DISCORD ALERTS ---
# Paste the Discord webhook URL from your server's settings
DISCORD_WEBHOOK_URL=PASTE_YOUR_DISCORD_WEBHOOK_HERE

# --- OPTIONAL: ETHEREUM INTEGRATION (Stellar submission only) ---
ETHERSCAN_API_KEY=PASTE_YOUR_KEY_HERE
WEB3_RPC_URL=PASTE_YOUR_ALCHEMY_URL_HERE
PROOF_OF_AUDIT_CONTRACT=LEAVE_BLANK_UNTIL_DEPLOYED
AUDIT_BADGE_NFT_CONTRACT=LEAVE_BLANK_UNTIL_DEPLOYED
SOROBAN_CONTRACT_ID=LEAVE_BLANK_UNTIL_DEPLOYED

# --- OPTIONAL: POSTGRES (defaults to local SQLite cache.db) ---
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,https://YOUR_FRONTEND_URL_HERE
